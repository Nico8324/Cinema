    "Choose a media folder in Settings, and the videos in it that aren’t MP4 will be listed here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Medienordner in den Einstellungen, und die Videos darin, die keine MP4 sind, werden hier aufgelistet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier multimédia dans Paramètres, et les vidéos qu'il contient qui ne sont pas MP4 seront répertoriées ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स में एक मीडिया फ़ोल्डर चुनें, और जो वीडियो MP4 नहीं हैं वे यहाँ सूचीबद्ध होंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でメディアフォルダを選択すると、MP4 ではない中のビデオがここにリストされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 미디어 폴더를 선택하면 MP4가 아닌 영상이 여기에 나열됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中选择一个媒体文件夹，其中非 MP4 的视频将在此列出。"
          }
        }
      }
    },
