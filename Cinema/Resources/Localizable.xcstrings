        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les épisodes partagent le titre de leur série — ceci renomme toute la série."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एपिसोड अपने शो का शीर्षक साझा करते हैं — इससे पूरे शो का नाम बदल जाएगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
