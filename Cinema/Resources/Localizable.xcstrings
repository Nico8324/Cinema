        }
      }
    },
    "The video streams from YouTube when you play it — nothing is downloaded to your library." : {
      "comment" : "A description of the YouTube video import process.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Video wird von YouTube gestreamt, wenn Sie es abspielen — nichts wird in Ihre Bibliothek heruntergeladen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vidéo est diffusée en continu à partir de YouTube lorsque vous la lisez — rien n'est téléchargé dans votre bibliothèque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप इसे चलाते हैं तो वीडियो YouTube से स्ट्रीम होता है — आपकी लाइब्रेरी में कुछ भी डाउनलोड नहीं होता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオを再生するとYouTubeからストリーミングされます — ライブラリにダウンロードされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오를 재생하면 YouTube에서 스트리밍되며 라이브러리에 다운로드되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放视频时，视频从YouTube流式传输——不会下载到您的媒体库。"
          }
        }
      }
    },
    "Theater" : {
