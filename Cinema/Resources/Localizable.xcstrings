    "Add videos to your library to search them.": {
      "comment": "A description of the content of the \"Your Library Is Empty\" view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Videos zu Ihrer Bibliothek hinzu, um sie zu durchsuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des vidéos à votre bibliothèque pour les rechercher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन्हें खोजने के लिए अपनी लाइब्रेरी में वीडियो जोड़ें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオを検索するには、ライブラリに追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리에 비디오를 추가하여 검색하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将视频添加到您的媒体库中以搜索它们。"
          }
        }
      }
    },
