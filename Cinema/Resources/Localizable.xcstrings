    "Refresh Metadata re-downloads titles, artwork, and details from The Movie Database for every matched video and show.": {
      "comment": "A description of the refresh metadata action.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadaten aktualisieren lädt Titel, Grafiken und Details aus der Filmdatenbank für jedes übereinstimmende Video und jede Show erneut herunter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiser les métadonnées retélécharge les titres, l'illustration et les détails de la base de données de films pour chaque vidéo et émission appariée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेटाडेटा रीफ्रेश करने से हर मेल खाने वाले वीडियो और शो के लिए द मूवी डेटाबेस से शीर्षक, कलाकृति और विवरण फिर से डाउनलोड होते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メタデータをリフレッシュすると、一致したすべてのビデオと番組について、The Movie Databaseからタイトル、アートワーク、詳細が再ダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메타데이터 새로 고침은 일치하는 모든 비디오 및 쇼에 대해 영화 데이터베이스에서 제목, 아트워크 및 세부 정보를 다시 다운로드합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新元数据会从电影数据库重新下载每个匹配视频和节목의 标题、插图和详细信息。"
          }
        }
      }
    },
    "Refreshing Metadata…": {
      "comment": "A message that appears when the user refreshes their library.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
