/// Local API credentials. Copy this file to `Secrets.swift` and fill in real values.
enum Secrets {
    /// The Movie Database v3 API key — https://www.themoviedb.org/settings/api
    static let tmdbAPIKey = "YOUR_TMDB_API_KEY"
}
