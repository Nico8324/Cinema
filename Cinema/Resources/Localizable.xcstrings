    "Renamed %@. %lld couldn’t be moved and were left alone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ umbenannt. %2$lld konnten nicht verschoben werden und blieben unverändert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ renommé(s). %2$lld n’ont pas pu être déplacés et ont été laissés tels quels."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ का नाम बदला गया। %2$lld को स्थानांतरित नहीं किया जा सका और उन्हें छोड़ दिया गया।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@の名前を変更しました。%2$lld 件は移動できなかったため、そのままにしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 이름을 변경했습니다. %2$lld개는 이동할 수 없어 그대로 두었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已重命名 %1$@。%2$lld 个无法移动，已保持原样。"
          }
        }
      }
    },
    "Renamed %@. Your library now points at the new names." : {
