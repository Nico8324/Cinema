    "Automatic follows your device’s light or dark setting.": {
      "comment": "A description of the \"Automatic\" setting for the \"Appearance\" picker.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Automatisch“ folgt der Hell- oder Dunkel-Einstellung deines Geräts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Automatique » suit le réglage clair ou sombre de votre appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“स्वचालित” आपके डिवाइस की लाइट या डार्क सेटिंग का पालन करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」はデバイスのライトまたはダークの設定に従います。"
          }
        },
