    "“%@” is already in your library.": {
      "comment": "A description of an error that might occur when importing a video. The argument is the name of the video.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist bereits in deiner Mediathek."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” est déjà dans votre bibliothèque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” पहले से आपकी लाइब्रेरी में है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はすでにライブラリにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) 이미 보관함에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已在您的资料库中。"
          }
        }
      }
    },
    "%@ %lld-channel audio has to be re-encoded to play": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$lld-channel audio has to be re-encoded to play"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld-Kanal-Audio muss erneut kodiert werden, um abgespielt zu werden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ L'audio %2$lld canaux doit être ré-encodé pour être lu"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld-चैनल ऑडियो को चलाने के लिए पुनः एन्कोड करना होगा"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld チャンネル オーディオは再生するために再度エンコードする必要があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld 채널 오디오는 재생하려면 다시 인코딩해야 합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld 声道音频需要重新编码才能播放"
          }
        }
      }
    },
