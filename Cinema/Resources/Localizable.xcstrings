          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एनिमेशन"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アニメーション"
          }
        },
        "ko" : {
          "stringUnit" : {
