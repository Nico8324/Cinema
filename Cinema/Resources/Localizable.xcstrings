    "Animation" : {
      "comment" : "The name of a movie genre.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animation"
          }
        },
        "fr" : {
          "stringUnit" : {
