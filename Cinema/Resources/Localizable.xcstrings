        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SDH ट्रैक को एक्सेसिबल के रूप में चिह्नित नहीं किया जा सका%@।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SDHトラックをアクセシブルとしてマークできませんでした%@。"
