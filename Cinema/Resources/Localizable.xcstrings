        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier converti comporte %lld pistes de sous-titres alors que %lld étaient attendues, leurs langues n’ont donc pas pu être définies en toute sécurité."
