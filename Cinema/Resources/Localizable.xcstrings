    },
    "That folder can’t be reached right now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesen Ordner kann derzeit nicht zugegriffen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce dossier est inaccessible pour le moment."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस फ़ोल्डर तक अभी पहुंचा नहीं जा सकता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このフォルダは現在アクセスできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 이 폴더에 접근할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在无法访问此文件夹。"
          }
        }
      }
    },
    "The conversion came out a different length than the original (%lld frames against %lld), so it was deleted rather than kept — a film that gains or loses frames has its sound and its Dolby Vision on the wrong ones." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Konvertierung ergab eine andere Länge als das Original (%lld Frames gegenüber %lld), daher wurde sie gelöscht statt behalten – bei einem Film, der Frames gewinnt oder verliert, liegen Ton und Dolby Vision auf den falschen Bildern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conversion n’a pas la même durée que l’original (%lld images contre %lld), elle a donc été supprimée plutôt que conservée — un film qui gagne ou perd des images a son son et son Dolby Vision décalés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कन्वर्जन की लंबाई मूल से अलग निकली (%lld फ़्रेम बनाम %lld), इसलिए इसे रखने के बजाय हटा दिया गया — जिस फ़िल्म में फ़्रेम बढ़ या घट जाते हैं, उसकी साउंड और Dolby Vision गलत फ़्रेम पर आ जाते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変換結果がオリジナルと異なる長さになったため(%1$lldフレーム対%2$lldフレーム)、保存せずに削除しました — フレーム数が増減した映画では、音声とDolby Visionが誤ったフレームに同期してしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변환 결과가 원본과 길이가 달라(%lld 프레임 대 %lld 프레임) 유지하지 않고 삭제했습니다 — 프레임이 늘거나 줄어든 영화는 사운드와 Dolby Vision이 잘못된 프레임에 맞춰집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "转换后的时长与原片不同（%lld帧对比%lld帧），因此已被删除而非保留 — 帧数增减的影片会导致其音频和杜比视界与画面错位。"
          }
        }
      }
    },
    "The conversion failed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Konvertierung ist fehlgeschlagen."
          }
        },
        "fr" : {
          "stringUnit" : {
