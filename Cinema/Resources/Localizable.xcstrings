    "%@ %@ audio has to be re-encoded to play" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@-Audio muss für die Wiedergabe neu codiert werden"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’audio %@ %@ doit être réencodé pour être lu"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ ऑडियो चलाने के लिए फिर से एन्कोड करना ज़रूरी है"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
