            "value": "Behält seine schwarzen Balken – das Zuschneiden würde eine erneute Kodierung bedeuten, und %@ länger"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve ses barres noires — les recadrer signifierait ré-encoder, et %@ plus long"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी काली पट्टियाँ रखता है — उन्हें काटने का अर्थ होगा पुनः एन्कोड करना, और %@ लंबा"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "黒帯を保持します — トリミングすると再エンコードが必要になり、%@ 長くなります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검은색 막대를 유지합니다 — 트리밍하면 다시 인코딩해야 하며 %@ 더 깁니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持其黑色条纹 — 裁剪它们意味着重新编码，并且 %@ 更长"
          }
        }
      }
    },
