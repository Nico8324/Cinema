        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変換されたファイルには%1$lld個の字幕トラックがありますが、期待されていたのは%2$lld個だったため、言語を安全に設定できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변환된 파일에 예상된 %lld개가 아니라 %lld개의 자막 트랙이 있어 언어를 안전하게 설정할 수 없었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
